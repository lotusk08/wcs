# Fixed in index.cjs, so not set here: SITE_URL, SECURE_DOMAINS, OAUTH_URL, COMMENT_AUDIT, DISABLE_REGION and
# MARKDOWN_TEX/EMOJI/SUB/SUP, and SERVER_URL in production; LOGIN, DISABLE_USERAGENT and MARKDOWN_HIGHLIGHT are ignored.
# See README, Settings.

# Secrets and connections: keep these in Vercel's environment settings only.
# Storage: TiDB in production. Set no other storage's variables: Waline takes the first storage it finds.
# Passkeys are kept in the same database, table <prefix>Passkeys.
TIDB_HOST=
TIDB_PORT=4000
TIDB_DB=
TIDB_USER=
TIDB_PASSWORD=
# Signs login tokens and passkey challenges. Defaults to TIDB_PASSWORD, so rotating the password would sign everyone out.
JWT_TOKEN=
# Mail: notifications and the reset-password link.
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Spam check (Waline falls back to a shared demo key; false turns it off).
AKISMET_KEY=
# Checks the login form's captcha, with its site key below.
RECAPTCHA_V3_SECRET=
TURNSTILE_SECRET=

# Settings still read from the environment (their value is not fixed in code yet).
# The site's name: the admin titles itself "Comments · <SITE_NAME>" (a name that already starts with "Comments" is
# used as it is), and Waline uses it in its mails. Default "Steve Hoang" in the admin
SITE_NAME=Steve Hoang
# Where Waline mails the owner about a new comment, and the mails' sender.
AUTHOR_EMAIL=
SENDER_NAME=
SENDER_EMAIL=
# Every avatar goes through <AVATAR_PROXY>?url=<avatar> when set.
AVATAR_PROXY=
# Seconds between two comments from one IP, and words that mark a comment as spam.
# IPQPS=60
FORBIDDEN_WORDS=
# The login form's captcha site keys (public).
RECAPTCHA_V3_KEY=
TURNSTILE_KEY=
# WebAuthn relying party id and origin. Default: the host and origin the request came in on
# (line.stevehoang.com / https://line.stevehoang.com in production). Passkeys only work on that host.
PASSKEY_RP_ID=
PASSKEY_ORIGIN=

# Switches, normally unset.
# Sign-up is closed: POST /api/user answers 403. Set to true only for an emergency (recreating the owner's account on
# an empty database), create the account with curl (send Referer: https://line.stevehoang.com/), then remove it and
# redeploy. Social login is always off.
ALLOW_REGISTER=
# Legacy: passkeys are now added and removed in Profile -> Passkeys and kept in the database (table <prefix>Passkeys).
# Entries still listed here are imported into that table once and then ignored; delete the variable once imported.
# A passkey sign-in skips the two-step verification code.
PASSKEYS=

# Local server only (npm run start:local): SQLite instead of TiDB.
# SQLITE_PATH=./.local
# JWT_TOKEN=local-development-secret
# WALINE_SQLITE_SCHEMA=/path/to/waline/assets/waline.sqlite
