# Storage: TiDB in production (Waline's TIDB_* variables; any other Waline storage works too, see
# https://waline.js.org/en/guide/database.html). Passkeys are kept in the same database, table <prefix>Passkeys.
TIDB_HOST=
TIDB_PORT=4000
TIDB_DB=
TIDB_USER=
TIDB_PASSWORD=
TIDB_PREFIX=wl_
# Signs login tokens and passkey challenges. Defaults to TIDB_PASSWORD, so rotating the password would sign everyone out.
JWT_TOKEN=

# Admin shell (served at /). All optional.
# Blog the comments belong to; the admin links back to it. Default https://stevehoang.com
SITE_URL=https://stevehoang.com
# The site's name. Waline uses it in its emails; the admin titles itself "Comments · <SITE_NAME>"
# (a name that already starts with "Comments" is used as it is). Default "Steve Hoang"
SITE_NAME=Steve Hoang
# Public URL of this server when it differs from the host the request came in on; the admin calls <SERVER_URL>/api/.
# Waline reads it too. Default: the request's own origin
SERVER_URL=
# More origins, comma-separated (https://a.example,https://b.example), trusted like SITE_URL: the admin posts the
# login token to them and returns to them after login.
ALLOWED_ORIGINS=
# Sign-up is closed: POST /api/user answers 403. Set to true only for an emergency (recreating the owner's account on
# an empty database), create the account with curl, then remove it and redeploy. Social login is always off, and
# OAUTH_URL is ignored.
ALLOW_REGISTER=
# Shown to the admin login form when set; Waline checks them server-side with their secrets.
RECAPTCHA_V3_KEY=
TURNSTILE_KEY=
# Legacy: passkeys are now added and removed in Profile -> Passkeys and kept in the database (table <prefix>Passkeys).
# Entries still listed here are imported into that table once and then ignored; delete the variable once imported.
# A passkey sign-in skips the two-step verification code.
PASSKEYS=
# WebAuthn relying party id and origin. Default: the host and origin the request came in on
# (line.stevehoang.com / https://line.stevehoang.com in production). Passkeys only work on that host.
PASSKEY_RP_ID=
PASSKEY_ORIGIN=

# Local server only (npm run start:local): SQLite instead of TiDB.
# SQLITE_PATH=./.local
# JWT_TOKEN=local-development-secret
# WALINE_SQLITE_SCHEMA=/path/to/waline/assets/waline.sqlite
